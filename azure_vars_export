# shellcheck shell=bash

# This file must be used with "source azure_vars_export" from bash,
# you should not run it directly

# You can login with the following command:
# az login --use-device-code --tenant <tenant_id>

_azure_vars_export() {
  local cmd vars_file location resource_group principal_name
  local principal_id credential_json role_scope my_ip
  local access_token arm_status attempt

  for cmd in az jq curl; do
    if ! command -v "${cmd}" > /dev/null 2>&1; then
      printf 'error: %s is required but was not found in PATH\n' "${cmd}" >&2
      return 1
    fi
  done

  vars_file="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/ubuntu-azure-vars.json"
  if [ ! -f "${vars_file}" ]; then
    printf 'error: %s not found\n' "${vars_file}" >&2
    return 1
  fi

  if ! ARM_SUBSCRIPTION_ID="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv)}" \
    || [ -z "${ARM_SUBSCRIPTION_ID}" ]; then
    printf 'error: could not determine the subscription ID; run "az login" first\n' >&2
    return 1
  fi

  location="${ARM_LOCATION:-northeurope}"
  resource_group="${ARM_RESOURCE_GROUP_NAME:-$(jq -r '.resource_group' "${vars_file}")}"
  principal_name="${ARM_PRINCIPAL_NAME:-$(jq -r '.principal_name' "${vars_file}")}"

  if [ -z "${resource_group}" ] || [ "${resource_group}" = "null" ] \
    || [ -z "${principal_name}" ] || [ "${principal_name}" = "null" ]; then
    printf 'error: resource_group and principal_name must be set in %s\n' "${vars_file}" >&2
    return 1
  fi

  if [ -z "$(az group list --query "[?name=='${resource_group}'].name" -o tsv)" ]; then
    az group create --location "${location}" --name "${resource_group}" || return 1
  fi

  role_scope="/subscriptions/${ARM_SUBSCRIPTION_ID}/resourceGroups/${resource_group}"

  principal_id="$(az ad sp list --display-name "${principal_name}" \
    --query "[?displayName=='${principal_name}'].appId | [0]" -o tsv)"

  if [ -z "${principal_id}" ]; then
    credential_json="$(az ad sp create-for-rbac \
      --role contributor \
      --scopes "${role_scope}" \
      --name "${principal_name}")" || return 1
  else
    credential_json="$(az ad sp credential reset --id "${principal_id}")" || return 1
  fi

  ARM_CLIENT_ID="$(printf '%s' "${credential_json}" | jq -r '.appId')"
  ARM_CLIENT_SECRET="$(printf '%s' "${credential_json}" | jq -r '.password')"
  ARM_TENANT_ID="$(printf '%s' "${credential_json}" | jq -r '.tenant')"
  unset credential_json

  if [ -z "${ARM_CLIENT_ID}" ] || [ "${ARM_CLIENT_ID}" = "null" ] \
    || [ -z "${ARM_CLIENT_SECRET}" ] || [ "${ARM_CLIENT_SECRET}" = "null" ]; then
    printf 'error: the service principal credentials came back empty\n' >&2
    return 1
  fi

  if [ -z "$(az role assignment list \
    --assignee "${ARM_CLIENT_ID}" \
    --scope "${role_scope}" \
    --query "[?roleDefinitionName=='Contributor'].id" -o tsv)" ]; then
    az role assignment create \
      --assignee "${ARM_CLIENT_ID}" \
      --role Contributor \
      --scope "${role_scope}" || return 1
  fi

  # A reset secret is not usable immediately, and an RBAC assignment can take minutes to propagate,
  # so poll a harmless ARM read at role_scope rather than only the token endpoint.
  arm_status=""
  attempt=1
  while [ "${attempt}" -le 12 ]; do
    access_token="$(
      printf 'grant_type=client_credentials&client_id=%s&client_secret=%s&scope=%s' \
        "${ARM_CLIENT_ID}" \
        "$(printf '%s' "${ARM_CLIENT_SECRET}" | jq -sRr @uri)" \
        'https%3A%2F%2Fmanagement.azure.com%2F.default' \
        | curl -sS --max-time 15 \
          -H 'Content-Type: application/x-www-form-urlencoded' \
          --data-binary @- \
          "https://login.microsoftonline.com/${ARM_TENANT_ID}/oauth2/v2.0/token" \
        | jq -r '.access_token // empty'
    )"

    if [ -n "${access_token}" ]; then
      # The token goes in a curl config file on stdin so it never appears in the process list.
      arm_status="$(
        printf 'header = "Authorization: Bearer %s"\nurl = "%s"\n' \
          "${access_token}" \
          "https://management.azure.com${role_scope}?api-version=2021-04-01" \
          | curl -sS -o /dev/null -w '%{http_code}' --max-time 15 --config -
      )"
    else
      arm_status="no-token"
    fi

    access_token=""

    if [ "${arm_status}" = "200" ]; then
      break
    fi

    if [ "${attempt}" -lt 12 ]; then
      sleep 10
    fi

    attempt=$((attempt + 1))
  done

  if [ "${arm_status}" != "200" ]; then
    printf 'error: %s was still not readable by the service principal after 12 attempts (last result %s)\n' \
      "${role_scope}" "${arm_status}" >&2
    return 1
  fi

  my_ip="${MY_IP_ADDRESS:-$(curl -fsS --max-time 5 https://api.ipify.org)}"
  if ! printf '%s' "${my_ip}" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    printf 'error: could not determine a public IPv4 address; set MY_IP_ADDRESS explicitly\n' >&2
    return 1
  fi
  MY_IP_ADDRESS="${my_ip}"

  export ARM_CLIENT_ID
  export ARM_CLIENT_SECRET
  export ARM_SUBSCRIPTION_ID
  export ARM_TENANT_ID
  export MY_IP_ADDRESS

  printf 'Exported ARM_* credentials for %s and MY_IP_ADDRESS=%s\n' \
    "${principal_name}" "${MY_IP_ADDRESS}"
}

_azure_vars_export
_azure_vars_export_status="$?"
unset -f _azure_vars_export

if [ "${_azure_vars_export_status}" -ne 0 ]; then
  unset -v _azure_vars_export_status
  return 1
fi

unset -v _azure_vars_export_status
